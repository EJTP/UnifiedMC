{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UnifiedMC",
  "mainBinaryName": "UnifiedMC",
  "version": "0.1.7",
  "identifier": "dev.unifiedmc.launcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "UnifiedMC",
        "width": 1020,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob: https://cdn.modrinth.com https://media.forgecdn.net https://mediafilez.forgecdn.net; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.modrinth.com https://api.curseforge.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
